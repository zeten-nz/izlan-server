# ───────────── Server ─────────────
PORT=4000
NODE_ENV=development
# Brauzer manzili (CORS emas, faqat email ichidagi havolalar uchun). Next rewrites orqali bir origin'da ishlaydi.
APP_URL=http://localhost:3000

# ───────────── Local PostgreSQL ─────────────
# CREATE DATABASE izlan_db;  (allaqachon yaratilgan)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=izlan_db
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/izlan_db?schema=public"

# ───────────── Auth ─────────────
# Kodlarni hash qilish uchun maxfiy kalit. Uzun tasodifiy qator qo'ying:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
SESSION_COOKIE_NAME=izlan_session
# "Meni eslab qol" belgilanmasa sessiya shuncha soat yashaydi (talab: 24)
SESSION_SHORT_HOURS=24
# "Meni eslab qol" belgilansa (va ro'yxatdan o'tgandan keyin avtomatik) shuncha kun
SESSION_REMEMBER_DAYS=30
# 6 xonali tasdiq kodi necha daqiqa amal qiladi
OTP_TTL_MINUTES=10
# Kodni qayta yuborish orasidagi minimal vaqt (soniya)
OTP_RESEND_SECONDS=60

# ───────────── Email (tasdiq kodlari uchun) ─────────────
# MAIL_DRIVER=console  → email yuborilmaydi, kod server konsoliga chiqadi (faqat DEV uchun).
# MAIL_DRIVER=resend   → Resend HTTP API (production uchun tavsiya). RESEND_API_KEY va MAIL_FROM kerak.
# MAIL_DRIVER=smtp     → SMTP orqali yuborish. Pastdagi SMTP_* qiymatlarini to'ldiring.
MAIL_DRIVER=console

# Resend (https://resend.com): API Keys bo'limidan kalit; domen (izlan.uz) Verified bo'lishi shart.
# Kalitni HECH QACHON repoga/frontend'ga qo'ymang. Faqat server muhitida.
RESEND_API_KEY=
# Kunlik yuborish limiti (Resend bepul tarif: 100/kun, zaxira uchun 90). Faqat resend driver'da; hisoblagich PostgreSQL'da (UTC kun).
EMAIL_DAILY_LIMIT=90
# Resend javobi shuncha ms'da kelmasa natija noaniq hisoblanadi
MAIL_SEND_TIMEOUT_MS=10000

# SMTP_HOST: pochta serveri manzili. Google'da qidiring: "<provayder nomi> SMTP settings"
#   Gmail: smtp.gmail.com | Yandex: smtp.yandex.com | Mail.ru: smtp.mail.ru
#   Servis: Resend (smtp.resend.com), Brevo (smtp-relay.brevo.com), SendGrid (smtp.sendgrid.net)
SMTP_HOST=smtp.example.com
# SMTP_PORT: 465 (SSL, SMTP_SECURE=true) yoki 587 (STARTTLS, SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER: odatda to'liq email manzil (yoki servisda "apikey"/"resend" kabi login).
SMTP_USER=
# SMTP_PASS: Gmail uchun oddiy parol EMAS, "App password" kerak.
#   Google'da qidiring: "Gmail app password" (Google Account → Security → 2-Step Verification yoqilgan bo'lishi shart).
SMTP_PASS=
# MAIL_FROM: xat "kimdan" ko'rinishi. Ko'p provayderlar SMTP_USER bilan bir xil domen/manzilni talab qiladi.
#   Google'da qidiring: "SPF DKIM DMARC setup" (xatlar spamga tushmasligi uchun, o'z domeningiz bo'lsa).
MAIL_FROM=

# ───────────── Dastlabki ADMIN (faqat bir marta, qo'lda: npm run db:seed:admin) ─────────────
# Yangi, bo'sh bazada birinchi adminni yaratish uchun. Admin allaqachon bo'lsa seed hech narsani o'zgartirmaydi.
# Admin yaratilgach SEED_ADMIN_PASSWORD ni muhitdan olib tashlang.
# Productionda: npm run db:seed:admin -- --confirm
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=
# SEED_ADMIN_BIRTH_YEAR=
