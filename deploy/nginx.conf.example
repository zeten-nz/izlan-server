# IZLAN — Nginx namunasi (production). Joylash: /etc/nginx/sites-available/izlan.uz
# Zanjir: mijoz → Nginx (TLS) → Next.js (127.0.0.1:3000) → Nest API (127.0.0.1:4000)
# Nest va Postgres tashqariga OCHILMAYDI (firewall: faqat 80/443 va cheklangan SSH).

limit_req_zone $binary_remote_addr zone=izlan_auth:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=izlan_all:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name izlan.uz www.izlan.uz;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://izlan.uz$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name izlan.uz;

    ssl_certificate     /etc/letsencrypt/live/izlan.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/izlan.uz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # HSTS shu yerda (Next sarlavhalarida yo'q). Avval max-age=300 bilan sinab, keyin 1 yilga oshiring.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 16m;   # ustoz media yuklashi (server limiti: 16 MB)
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # MUHIM (SEC-02): mijoz yuborgan X-Forwarded-For'ni ALMASHTIRAMIZ. Next uni o'zgartirmay o'tkazadi,
    # Nest esa (TRUST_PROXY_HOPS=1) eng o'ngdagi qiymatni haqiqiy IP deb oladi.
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host              $host;

    # Ichki API (pay-bot, grammatika) tashqaridan YOPIQ — ular 127.0.0.1:4000 ga to'g'ridan-to'g'ri ulanadi.
    location ^~ /api/internal/ { return 404; }

    location ^~ /api/auth/ {
        limit_req zone=izlan_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }

    location / {
        limit_req zone=izlan_all burst=60 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # DIQQAT: location ichida bitta proxy_set_header bo'lsa, server darajasidagilar MEROS OLINMAYDI —
        # shuning uchun to'rttasi shu yerda takrorlanadi (aks holda mijozning XFF'i Nest'ga yetib boradi).
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host              $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
