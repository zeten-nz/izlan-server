generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  email           String   @unique
  firstName       String
  lastName        String
  birthYear       Int
  passwordHash    String
  role            Role     @default(STUDENT)
  emailVerifiedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Yo'nalish tanlash taklifi yopilganmi (bir martalik taklif, keyin Asosiy sahifada eslatma)
  directionPromptDismissedAt DateTime?

  sessions   Session[]
  directions UserDirection[]
  mistakes   UserMistake[]
  placements PlacementAttempt[]

  lessons        Lesson[]
  lessonAttempts LessonBlockAttempt[]
  lessonProgress LessonProgress[]
  assets         Asset[]

  vocabulary VocabularyEntry[]
  notes      StudentNote[]
  saved      SavedMaterial[]

  profile      Profile?
  wallet       Wallet?
  equipped     EquippedCosmetics?
  cosmetics    CosmeticOwnership[]
  achievements UserAchievement[]

  xpLedger         XpLedger[]
  xpTopicDays      XpTopicDay[]
  topicCompletions TopicCompletion[]
  quizAttempts     QuizAttempt[]
  authoredQuizzes  TopicQuiz[]       @relation("QuizAuthor")
}

/// Server-side sessiya. Cookie'da faqat tasodifiy token, bazada uning hash'i.
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  /// "Meni eslab qol" belgilanganmi (cookie doimiy yoki sessiya-cookie)
  remember  Boolean
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Email tasdiqlanmaguncha foydalanuvchi yaratilmaydi: ma'lumot shu yerda turadi.
model PendingRegistration {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  firstName    String
  lastName     String
  birthYear    Int
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  lastSentAt   DateTime
  createdAt    DateTime @default(now())

  @@index([username])
  @@index([expiresAt])
}

model PasswordReset {
  id         String   @id @default(uuid())
  userId     String   @unique
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime
  createdAt  DateTime @default(now())
}

/// Kunlik email kvotasi (Resend bepul tarifi): kun (UTC) boshiga ishlatilgan xatlar soni. Atomik rezerv qilinadi.
model EmailQuota {
  day       String   @id
  used      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ───────────── O'quv mazmuni (hozircha seed, keyin admin/ustoz tomonidan) ─────────────

enum DirectionKind {
  LANGUAGE
  SUBJECT
}

model Direction {
  id          String        @id @default(uuid())
  slug        String        @unique
  kind        DirectionKind
  title       String
  description String
  /// false = "Tez orada": tanlab bo'lmaydi
  active      Boolean       @default(false)
  sortOrder   Int           @default(0)

  levels     Level[]
  users      UserDirection[]
  questions  Question[]
  placements PlacementAttempt[]
}

model Level {
  id          String   @id @default(uuid())
  directionId String
  code        String
  /// 1 dan boshlab: A1=1 ... C2=6
  ord         Int
  title       String
  summary     String
  /// "Bu darajada nimalarni bilishingiz kerak" ro'yxati
  canDo       String[]
  vocabHint   String

  direction Direction  @relation(fields: [directionId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]

  @@unique([directionId, ord])
}

model Topic {
  id      String @id @default(uuid())
  levelId String
  ord     Int
  /// Hozircha faqat sarlavha; mazmunni ustoz qo'shadi
  title   String

  level     Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  rules     Rule[]
  questions Question[]
  lessons   Lesson[]
  quiz      TopicQuiz?

  @@unique([levelId, ord])
}

/// Xato turi (takroriy xatolar shu bo'yicha sanaladi) va uning tushuntirishi
model Rule {
  id       String @id @default(uuid())
  key      String @unique
  topicId  String
  title    String
  tipTitle String
  /// Oddiy matn; "- " bilan boshlangan qatorlar ro'yxat, **...** qalin
  tipBody  String
  remember String

  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id              String   @id @default(uuid())
  key             String   @unique
  directionId     String
  levelId         String
  topicId         String
  ruleId          String
  /// Bo'sh joy "_____" bilan
  prompt          String
  instruction     String
  options         String[]
  correctIndex    Int
  correctSentence String
  /// Shu savolga xos qisqa izoh (qoida izohiga qo'shimcha)
  note            String

  direction Direction     @relation(fields: [directionId], references: [id], onDelete: Cascade)
  level     Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  topic     Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  rule      Rule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  mistakes  UserMistake[]

  @@index([directionId, levelId])
}

// ───────────── Foydalanuvchi jarayoni ─────────────

enum LevelAccess {
  /// Joriy darajada mavzular tartib bilan ochiladi
  SEQUENTIAL
  /// Joriy darajaning hamma mavzulari ochiq (75-90% natija)
  OPEN
}

model UserDirection {
  id              String      @id @default(uuid())
  userId          String
  directionId     String
  /// null = daraja hali aniqlanmagan
  currentLevelOrd Int?
  levelAccess     LevelAccess @default(SEQUENTIAL)
  /// Daraja qanday aniqlangan: ZERO | CLAIMED | UNKNOWN
  placedBy        String?
  /// Har daraja uchun ochilgan eng yuqori mavzu tartibi: { "<levelOrd>": <topicOrd> }. Faqat oshadi (ratchet):
  /// ustoz darsni nashrdan olsa yoki yangi dars qo'shsa, oldin ochilgan mavzu qayta qulflanmaydi.
  topicFrontier   Json        @default("{}")
  createdAt       DateTime    @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)

  @@unique([userId, directionId])
}

enum PlacementMode {
  CLAIMED
  UNKNOWN
}

model PlacementAttempt {
  id          String        @id @default(uuid())
  userId      String
  directionId String
  mode        PlacementMode
  /// CLAIMED rejimida tanlangan daraja
  claimedOrd  Int?
  /// Savollar tartibi (CLAIMED: oldindan; UNKNOWN: bosqichma-bosqich to'ldiriladi)
  questionIds String[]
  /// Javoblar: { questionId, choice, correct, levelOrd }[]
  answers     Json          @default("[]")
  done        Boolean       @default(false)
  scorePct    Int?
  /// Natija: ADVANCE | REPEAT_OPEN | START_ZERO | RETEST_LOWER | PLACED
  outcome     String?
  resultOrd   Int?
  createdAt   DateTime      @default(now())
  finishedAt  DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)

  @@index([userId, directionId])
}

/// Har bir (foydalanuvchi, savol) uchun bitta qator: takror xatolar dublikat bo'lmaydi, soni oshadi.
model UserMistake {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  count      Int      @default(1)
  lastChoice Int
  lastAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

// ───────────── Vizual darslar (Lesson Builder) ─────────────

enum LessonVersionStatus {
  DRAFT
  PUBLISHED
}

/// Ustoz yaratgan dars. Mazmun `LessonVersion.doc` (JSON hujjat) ichida.
model Lesson {
  id                 String   @id @default(uuid())
  topicId            String
  authorId           String
  title              String
  /// Hozir o'quvchilarga ko'rinayotgan (o'zgarmas) versiya; null = hali nashr qilinmagan
  publishedVersionId String?  @unique
  /// Mavzu ichidagi tartib (oraliq 100). Teng bo'lsa createdAt, id bo'yicha.
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  topic     Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author    User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  versions  LessonVersion[] @relation("LessonVersions")
  published LessonVersion?  @relation("LessonPublished", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@index([topicId, sortOrder])
  @@index([authorId])
}

/// DRAFT: har dars uchun bitta, tahrirlanadi (`rev` — optimistic lock). PUBLISHED: o'zgarmas snapshot.
model LessonVersion {
  id          String              @id @default(uuid())
  lessonId    String
  status      LessonVersionStatus
  rev         Int                 @default(1)
  /// Versiyalangan hujjat: { schemaVersion, pages[] }. Tuzilishi server/src/lessons/doc.schema.ts da.
  doc         Json
  createdAt   DateTime            @default(now())
  publishedAt DateTime?

  lesson       Lesson               @relation("LessonVersions", fields: [lessonId], references: [id], onDelete: Cascade)
  publishedFor Lesson?              @relation("LessonPublished")
  attempts     LessonBlockAttempt[]
  progress     LessonProgress[]

  @@index([lessonId, status])
}

/// Har (o'quvchi, versiya, blok) uchun bitta qator.
model LessonBlockAttempt {
  id          String   @id @default(uuid())
  userId      String
  versionId   String
  blockId     String
  tries       Int      @default(1)
  /// Oxirgi urinish to'g'rimi
  correct     Boolean
  /// Hech bo'lmaganda bir marta to'g'ri javob berilganmi
  everCorrect Boolean
  /// Noto'g'ri urinishlar soni (Daftar → Xatolarim). Eski qatorlar uchun pastki chegara: migration to'ldirgan.
  wrongTries  Int      @default(0)
  response    Json
  updatedAt   DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  version LessonVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([userId, versionId, blockId])
}

model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  versionId      String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  /// Oxirgi tasdiqlangan sahifa tartibi (faqat davom ettirish uchun; progress emas)
  lastPageIndex  Int?
  /// Haqiqatan ochib ko'rilgan sahifa id'lari (faqat qo'shiladi). Ochiq sahifa va tugatishdan alohida.
  visitedPageIds String[]  @default([])

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  version LessonVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([userId, versionId])
}

// ───────────── Daftar (o'quvchining shaxsiy bilim maydoni) ─────────────
// Manba havolalari (directionId/topicId/lessonId/pageId) ataylab FK'siz: dars/mavzu o'chirilsa yozuv saqlanadi,
// o'qishda "mavjud emas" holati ko'rsatiladi. `source*` — yaratilgan paytdagi nomlar (snapshot).

/// Lug'at: so'z/atama + ma'no. Bir so'z turli ma'noda bo'lishi mumkin: (userId, termKey, meaningKey) yagona,
/// ammo termKey bo'yicha takrorlar avtomatik birlashtirilmaydi.
model VocabularyEntry {
  id          String   @id @default(uuid())
  userId      String
  term        String
  /// Normallashtirilgan (kichik harf, bo'shliq/apostrof) — qidirish va takrorni aniqlash uchun
  termKey     String
  meaning     String   @default("")
  meaningKey  String   @default("")
  example     String   @default("")
  note        String   @default("")
  directionId String?
  topicId     String?
  lessonId    String?
  pageId      String?
  sourceTitle String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termKey, meaningKey])
  @@index([userId, createdAt])
  @@index([userId, directionId])
  @@index([userId, topicId])
}

/// Shaxsiy eslatma (mustaqil yoki dars/sahifa bilan bog'langan).
model StudentNote {
  id          String   @id @default(uuid())
  userId      String
  title       String   @default("")
  body        String
  directionId String?
  topicId     String?
  lessonId    String?
  pageId      String?
  sourceTitle String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, directionId])
  @@index([userId, topicId])
}

/// Saqlangan dars yoki uning sahifasi. pageId '' = butun dars. Sahifa id'si dars hujjatidagi real `pages[].id`.
model SavedMaterial {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  pageId      String   @default("")
  directionId String?
  topicId     String?
  lessonTitle String
  pageTitle   String   @default("")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, pageId])
  @@index([userId, createdAt])
  @@index([userId, directionId])
  @@index([userId, topicId])
}

enum AssetKind {
  IMAGE
  AUDIO
}

/// Ustoz yuklagan rasm/audio. Fayl diskda (UPLOAD_DIR/<id>), hujjatda faqat id.
model Asset {
  id           String    @id @default(uuid())
  ownerId      String
  kind         AssetKind
  /// Fayl mazmunidan aniqlangan (mijoz aytgan Content-Type'ga ishonilmaydi)
  mime         String
  size         Int
  originalName String
  createdAt    DateTime  @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// ───────────── Profil, mukofotlar va shaxsiy identifikatsiya ─────────────
// XP/IZL berish va sarflash mexanizmi HOZIRCHA YO'Q: balanslar faqat o'qiladi (qator bo'lmasa 0).

/// Ommaviy profil sozlamalari. Qator bo'lmasa — hammasi yopiq (xavfsiz standart).
model Profile {
  userId           String   @id
  bio              String   @default("")
  isPublic         Boolean  @default(false)
  showFullName     Boolean  @default(false)
  showAchievements Boolean  @default(false)
  showStats        Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Eski username -> user (username o'zgarsa eski havola yangisiga yo'naltiriladi). Yozuv username o'zgartirish
/// funksiyasi qo'shilganda shu jadvalga yoziladi; hozir faqat qidiruv tayyor.
model UsernameAlias {
  oldUsername String   @id
  userId      String
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// XP/IZL balansi. xpBalance — sarflanadigan; totalXpEarned — jami (xariddan kamaymaydi); izlBalance — alohida valyuta.
/// Manfiy bo'lmasligi DB CHECK bilan kafolatlanadi (migration.sql).
model Wallet {
  userId        String   @id
  xpBalance     Int      @default(0)
  totalXpEarned Int      @default(0)
  izlBalance    Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CosmeticKind {
  FRAME
  BANNER
  EFFECT
  TITLE
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum CosmeticStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum OwnershipSource {
  PURCHASE
  ACHIEVEMENT
  EVENT
  ADMIN_GRANT
}

/// Bezak katalogi. Katalogdan "olib tashlash" = status DISABLED; qator o'chirilmaydi (egalik saqlanadi).
model CosmeticItem {
  id          String         @id @default(uuid())
  slug        String         @unique
  kind        CosmeticKind
  rarity      Rarity
  name        String
  description String         @default("")
  /// null = narx hali belgilanmagan
  priceXp     Int?
  status      CosmeticStatus @default(DRAFT)
  /// Vizual tavsif (tokenlar): klient o'z tokenlari orqali chizadi, ixtiyoriy HTML/CSS qabul qilinmaydi
  preview     Json           @default("{}")
  season      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owners CosmeticOwnership[]

  @@index([kind, status])
}

model CosmeticOwnership {
  id         String          @id @default(uuid())
  userId     String
  itemId     String
  source     OwnershipSource
  acquiredAt DateTime        @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item CosmeticItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, itemId])
  @@index([itemId])
}

/// Har turdan bittadan faol bezak (tuzilma bo'yicha kafolat). Egalik tekshiruvi servisda.
model EquippedCosmetics {
  userId    String   @id
  frameId   String?
  bannerId  String?
  effectId  String?
  titleId   String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Yutuq ta'rifi. Avtomatik berish mexanizmi yo'q: UserAchievement faqat kelajakdagi integratsiya uchun.
model AchievementDefinition {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String   @default("")
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@unique([userId, achievementId])
}

/// Admin amallari jurnali (faqat qo'shiladi).
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

// ───────────── XP iqtisodiyoti: ledger, mavzu belgilari va mavzu testi ─────────────
// XP berish FAQAT server hodisalari orqali (src/xp). Wallet shu ledger bilan bitta tranzaksiyada yangilanadi.

enum XpEventType {
  LESSON_COMPLETE
  TOPIC_COMPLETE
  QUIZ_TIER
  NOTE_VERIFIED
}

/// EARN hozir yagona ishlatiladi; SPEND/ADJUST kelajakdagi xarid va tuzatishlar uchun zaxira (grantedXp <= 0).
enum XpEntryKind {
  EARN
  SPEND
  ADJUST
}

/// Append-only XP jurnali: UPDATE DB trigger bilan taqiqlangan, DELETE faqat foydalanuvchi o'chirilganda (cascade).
model XpLedger {
  id            String      @id @default(uuid())
  userId        String
  kind          XpEntryKind @default(EARN)
  eventType     XpEventType
  /// Manba: dars id, mavzu id (mavzu/test hodisalari)
  sourceId      String
  topicId       String?
  /// Siyosat bo'yicha bazaviy XP (koeffitsiyentgacha)
  baseXp        Int
  /// Qo'llangan koeffitsiyent (bazis punkt, 10000 = 100%) — snapshot
  multiplierBp  Int
  /// Haqiqatan berilgan butun XP
  grantedXp     Int
  /// Takroriy hodisani bloklaydi (masalan lesson:{userId}:{lessonId})
  dedupeKey     String      @unique
  policyVersion String
  /// Asia/Tashkent bo'yicha sana (YYYY-MM-DD)
  dayKey        String
  /// Mavzuning o'sha kundagi tartibi (1,2,3...)
  topicDayOrd   Int?
  balanceAfter  Int
  totalAfter    Int
  meta          Json        @default("{}")
  createdAt     DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, dayKey, topicId])
}

/// Foydalanuvchi mavzusining kundagi tartibi: birinchi haqiqiy XP hodisasida belgilanadi va o'zgarmaydi.
model XpTopicDay {
  userId    String
  dayKey    String
  topicId   String
  ord       Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dayKey, topicId])
  @@unique([userId, dayKey, ord])
}

/// Mavzu BIRINCHI marta tugatilganini ishonchli saqlaydi: keyin dars qo'shilsa ham mavzu XP takrorlanmaydi.
/// source = LESSONS (XP berilgan) | BACKFILL (migratsiyada mavjud tarixdan belgilangan, XP berilmagan).
model TopicCompletion {
  userId      String
  topicId     String
  completedAt DateTime @default(now())
  source      String   @default("LESSONS")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
}

/// Mavzu testi (mavzuga bitta): savollar versiyalarda, natija backend'da hisoblanadi.
model TopicQuiz {
  id        String   @id @default(uuid())
  topicId   String   @unique
  authorId  String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic    Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author   User          @relation("QuizAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  versions QuizVersion[]
}

/// DRAFT: har test uchun bitta (rev — optimistic lock). PUBLISHED: o'zgarmas snapshot; eng so'nggisi amal qiladi.
model QuizVersion {
  id          String              @id @default(uuid())
  quizId      String
  status      LessonVersionStatus
  rev         Int                 @default(1)
  /// [{ id, text, options: [{ id, text }], correctId }]
  questions   Json
  createdAt   DateTime            @default(now())
  publishedAt DateTime?

  quiz     TopicQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([quizId, status])
}

model QuizAttempt {
  id           String   @id @default(uuid())
  userId       String
  versionId    String
  /// { [questionId]: optionId }
  answers      Json
  correctCount Int
  total        Int
  scorePct     Int
  createdAt    DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  version QuizVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([userId, versionId])
}
