# Izlan backup sozlamalari. Nusxa: /etc/izlan-backup/backup.env  (chmod 600, egasi: backup foydalanuvchisi)
# Parol bu faylga YOZILMAYDI: PostgreSQL uchun PGPASSFILE (~/.pgpass) yoki peer-auth ishlating.

# --- Majburiy ---
IZLAN_DB_NAME=izlan_db
IZLAN_UPLOADS_DIR=/srv/izlan/server/uploads     # serverdagi UPLOAD_DIR bilan bir xil

# --- PostgreSQL ulanishi (libpq o'zgaruvchilari; kerak bo'lsa) ---
#PGHOST=localhost
#PGPORT=5432
#PGUSER=izlan_backup
#PGPASSFILE=/etc/izlan-backup/pgpass            # chmod 600; satr: localhost:5432:izlan_db:izlan_backup:<parol>

# --- Ixtiyoriy (standart qiymatlar ko'rsatilgan) ---
#IZLAN_BACKUP_ROOT=/var/backups/izlan
#IZLAN_KEEP_DAYS=7                              # nechta KUN saqlanadi (har kundan eng so'nggi nusxa)
#IZLAN_MIN_FREE_MB=1024                         # backup'dan keyin ham qolishi kerak bo'lgan joy
#IZLAN_LOG_FILE=/var/log/izlan-backup.log
#IZLAN_COUNT_TABLES="User Asset LessonVersion"  # restore tekshiruvi uchun
#IZLAN_PRODUCTION_DB=                           # qo'shimcha himoyalangan DB nomi (IZLAN_DB_NAME doim himoyalangan)
